# PostgreSQL Database
AIV_DB_USER=postgres
AIV_DB_PASSWORD=postgres
AIV_DB_URL=jdbc:postgresql://db:5432/postgres
DB_PORT=5432

# pgAdmin4
PGADMIN_DEFAULT_EMAIL=pgadmin@aiv.com
PGADMIN_DEFAULT_PASSWORD=aivhub
PGADMIN_PORT=8088

# --- Host / public URLs (set HOST_IP to your machine LAN IPv4) ---
# Browsers and SSO redirects use these — NOT container localhost.
# If you use Apache/IIS/nginx in front, set AUTH_PUBLIC_URL / AIV_PUBLIC_URL to your proxy URLs instead.
HOST_IP=localhost
AUTH_PORT=8087
AIV_PORT=8083
AIV_AI_PORT=8002
AUTH_PUBLIC_URL=http://localhost:8087
AIV_PUBLIC_URL=http://localhost:8083

# AIV → Auth server-side calls use Docker network (http://universalauth:8080) — do not change unless you rename the service.

# AIV Liquibase (set false after first successful boot if you prefer)
LIQUIBASE_AIV_ENABLED=true

# JVM Timezone
APP_TIMEZONE=Europe/London