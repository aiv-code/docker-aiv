<?xml version="1.0" encoding="UTF-8"?>
<!--
  AIV 7.x channel logging (docker: app.logDir = ${aiv_base}/logs → /opt/logs).
  Override with env LOG_DIR or -DLOG_DIR=...
-->
<configuration scan="true" scanPeriod="60 seconds">

    <springProperty scope="context" name="APP_LOG_DIR" source="app.logDir" defaultValue="logs"/>
    <property name="LOG_LEVEL"      value="${LOG_LEVEL:-INFO}"/>
    <property name="LOG_DIR"        value="${LOG_DIR:-${APP_LOG_DIR}}"/>
    <property name="LOG_ENV"        value="${LOG_ENV:-docker}"/>
    <property name="MAX_FILE_SIZE"  value="50MB"/>
    <property name="TOTAL_SIZE_CAP" value="20GB"/>
    <property name="MAX_HISTORY"    value="60"/>

    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{0} [trace=%X{traceid:-} dept=%X{deptCode:-}] - %msg%n%ex"/>
    <property name="PLAIN_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{0} [trace=%X{traceid:-} dept=%X{deptCode:-} src=%X{sourceClass:-}] - %msg%n%ex"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="ALL-PLAIN-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/all-plain.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/all-plain.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${PLAIN_PATTERN}</pattern>
        </encoder>
    </appender>
    <appender name="ALL-PLAIN-ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ALL-PLAIN-FILE"/>
        <queueSize>4096</queueSize>
        <neverBlock>true</neverBlock>
    </appender>

    <appender name="CORE-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/core.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/core.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"aiv","env":"${LOG_ENV}","channel":"core"}</customFields>
        </encoder>
    </appender>
    <appender name="CORE-ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CORE-FILE"/>
        <queueSize>2048</queueSize>
        <neverBlock>true</neverBlock>
    </appender>
    <logger name="core" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="CORE-ASYNC"/>
        <appender-ref ref="ALL-PLAIN-ASYNC"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="gateway" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="CORE-ASYNC"/>
        <appender-ref ref="ALL-PLAIN-ASYNC"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="rest" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="CORE-ASYNC"/>
        <appender-ref ref="ALL-PLAIN-ASYNC"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="birt" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="CORE-ASYNC"/>
        <appender-ref ref="ALL-PLAIN-ASYNC"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="jasper" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="CORE-ASYNC"/>
        <appender-ref ref="ALL-PLAIN-ASYNC"/>
        <appender-ref ref="CONSOLE"/>
    </logger>
    <logger name="user" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="CORE-ASYNC"/>
        <appender-ref ref="ALL-PLAIN-ASYNC"/>
    </logger>

    <appender name="SECURITY-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/security.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <maxHistory>365</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"aiv","env":"${LOG_ENV}","channel":"security"}</customFields>
        </encoder>
    </appender>
    <logger name="security" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="SECURITY-FILE"/>
        <appender-ref ref="ALL-PLAIN-ASYNC"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <appender name="DATA-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/data.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/data.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"aiv","env":"${LOG_ENV}","channel":"data"}</customFields>
        </encoder>
    </appender>
    <appender name="DATA-ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="DATA-FILE"/>
        <queueSize>2048</queueSize>
        <neverBlock>true</neverBlock>
    </appender>
    <logger name="data" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="DATA-ASYNC"/>
        <appender-ref ref="ALL-PLAIN-ASYNC"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <appender name="DB-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/db.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/db.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <maxHistory>${MAX_HISTORY}</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"aiv","env":"${LOG_ENV}","channel":"db"}</customFields>
        </encoder>
    </appender>
    <appender name="DB-ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="DB-FILE"/>
        <queueSize>2048</queueSize>
        <neverBlock>true</neverBlock>
    </appender>
    <logger name="db" level="${LOG_LEVEL}" additivity="false">
        <appender-ref ref="DB-ASYNC"/>
        <appender-ref ref="ALL-PLAIN-ASYNC"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="org.springframework" level="WARN"/>
    <logger name="org.apache" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="CORE-ASYNC"/>
        <appender-ref ref="ALL-PLAIN-ASYNC"/>
    </root>

</configuration>
